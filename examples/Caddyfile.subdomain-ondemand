# Subdomain mode with a certificate per channel, issued on the first request.
# No DNS API needed - only DNS records:  A/AAAA  {$DOMAIN}  and  A/AAAA  *.{$DOMAIN}  -> your server.
# Requires BASE_DOMAIN={$DOMAIN} for LineRoulette. Caddy asks LineRoulette before issuing a certificate,
# so only existing channels (and ADMIN_HOST) get one.
{
	on_demand_tls {
		ask http://lineroulette:8080/caddy-ask
	}
}

{$DOMAIN} {
	reverse_proxy lineroulette:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy lineroulette:8080
}
